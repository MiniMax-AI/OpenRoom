# Extra hosts the dev server accepts, comma-separated (optional).
# Needed when opening the app via a LAN IP or a reverse-proxy domain, e.g. on a phone.
# Use "true" to allow any host (trusted networks only).
# ALLOWED_HOSTS=myapp.example.com,192.168.1.10
ALLOWED_HOSTS=

# CDN prefix for static assets (optional, leave empty for local assets)
CDN_PREFIX=

# RUM monitoring (optional)
VITE_RUM_SITE=
VITE_RUM_CLIENT_TOKEN=

# Sentry error tracking (optional, plugin only loads when SENTRY_AUTH_TOKEN is set)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
